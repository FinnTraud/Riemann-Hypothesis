          {
            "nullstelle": "(0.5 + 114.320220915453j)",
            "Re": "0.5",
            "Im": "114.320220915453",
            "abstand_zur_kritischen_geraden": "0.0",
            "residuum_|f|": "9.05e-22",
            "abseits": false
          },
          {
            "nullstelle": "(0.5 + 176.44143429771j)",
            "Re": "0.5",
            "Im": "176.44143429771",
            "abstand_zur_kritischen_geraden": "0.0",
            "residuum_|f|": "4.7e-20",
            "abseits": false
          }
        ],
        "trennt_zeta_von_dh": true,
        "lehre": "DH verletzt die RH nicht knapp, sondern deutlich (Re bis ~0.81 statt 0.5)."
      },
      "T4_vorzeichenwechsel_defizit": {
        "test": "T4 Vorzeichenwechsel-Defizit (Turing-Methode)",
