        "funktion": "zeta",
        "bestanden": true,
        "max_rel_abweichung": "1.71e-21",
        "punkte": [
          {
            "s": "2+1i",
            "rel_abweichung": "1.71e-21"
          },
          {
            "s": "0.3+4.0i",
            "rel_abweichung": "1.38e-21"
          },
          {
            "s": "1.7+-2.5i",
            "rel_abweichung": "1.19e-22"
          }
        ],
        "trennt_zeta_von_dh": false,
        "lehre": "Nicht trennend: die Funktionalgleichung ist KEIN RH-Indikator."
      },
      "T2_euler_produkt": {
        "test": "T2 Multiplikativitaet a(mn)=a(m)a(n)  (Euler-Produkt)",
        "funktion": "zeta",
        "bestanden": true,
        "verletzungen": [],
        "trennt_zeta_von_dh": true,
        "lehre": "Trennend. Die einzige der vier Struktureigenschaften, die DH fehlt -- und damit die einzige, an der ein RH-Beweis ansetzen kann."
      },
      "T3_offline_nullstellen": {
        "test": "T3 Nullstellen abseits der kritischen Geraden",
        "funktion": "zeta",
        "rh_verletzung_nachgewiesen": false,
